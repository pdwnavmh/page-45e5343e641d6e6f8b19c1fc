r:1px solid #3d5a76;color:#c6d6e5}\n.btn-ghost:hover{border-color:var(--amber);color:var(--amber);text-decoration:none}\n\n.hero-panel{background:var(--ink-2);border:1px solid var(--ink-3);border-top:3px solid var(--amber);padding:30px 30px 26px}\n.hero-panel h2{color:#fff;font-size:15px;letter-spacing:2px;font-weight:600;padding-bottom:14px;margin-bottom:18px;border-bottom:1px solid var(--ink-3)}\n.spec-row{display:flex;justify-content:space-between;gap:16px;padding:11px 0;border-bottom:1px dashed #24405c;font-size:14px}\n.spec-row:last-child{border-bottom:none}\n.spec-row dt{color:#8ba3ba;white-space:nowrap}\n.spec-row dd{color:#e8f0f8;text-align:right}\n.spec-row dd b{color:var(--amber);font-weight:700}\n.panel-note{margin-top:18px;padding-top:14px;border-top:1px solid var(--ink-3);font-size:12.5px;color:#7d96ad;line-height:1.7}\n\n/* 通用区块 */\nsection.block{padding:84px 24px}\n.wrap{max-width:1180px;margin:0 auto}\n.sec-head{margin-bottom:52px;max-width:44em}\n.sec-head .no{color:var(--amber-deep);font-size:13px;letter-spacing:3px;display:block;margin-bottom:10px}\n.sec-head h2{font-size:clamp(24px,3vw,32px);color:var(--ink);letter-spacing:1px;line-height:1.35;margin-bottom:14px}\n.sec-head p{color:var(--muted);font-size:15px}\n\n/* 无边框、仅靠留白分隔的卡片 */\n.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:56px}\n.card h3{font-size:18px;color:var(--ink);margin-bottom:14px;letter-spacing:1px}\n.card h3::before{content:\"\";display:block;width:28px;height:3px;background:var(--amber);margin-bottom:14px}\n.card p{font-size:14.5px;color:var(--muted)}\n.card p + p{margin-top:10px}\n\n/* 阶梯式套餐 */\n.plans{display:flex;align-items:flex-end;gap:32px}\n.plan{flex:1;background:#fff;border:1px solid var(--line);padding:34px 30px 30px;display:flex;flex-direction:column}\n.plan:nth-child(1){min-height:420px}\n.plan:nth-child(2){min-height:500px;border-top:4px solid var(--amber)}\n.plan:nth-child(3){min-height:580px}\n.plan .tag{font-size:12px;letter-spacing:2px;color:var(--amber-deep);margin-bottom:10px}\n.plan h3{font-size:22px;color:var(--ink);letter-spacing:1px}\n.plan .price{margin:16px 0 4px;font-size:30px;font-weight:700;color:var(--ink)}\n.plan .price small{font-size:14px;font-weight:400;color:var(--muted)}\n.plan .annual{font-size:13px;color:var(--amber-deep);margin-bottom:22px}\n.plan ul{list-style:none;margin-bottom:26px;flex:1}\n.plan li{font-size:14px;color:var(--text);padding:9px 0 9px 20px;position:relative;border-bottom:1px dashed var(--line)}\n.plan li::before{content:\"\";position:absolute;left:0;top:17px;width:8px;height:8px;background:var(--amber)}\n.plan li:last-child{border-bottom:none}\n.plan .pick{display:block;text-align:center;padding:12px;font-size:14px;letter-spacing:2px;border:1px solid var(--ink);color:var(--ink)}\n.plan .pick:hover{background:var(--ink);color:#fff;text-decoration:none}\n.plan.featured .pick{background:var(--amber);border-color:var(--amber);color:var(--ink);font-weight:700}\n.plan.featured .pick:hover{background:#f2b45c}\n.plan .badge{align-self:flex-start;background:var(--ink);color:var(--amber);font-size:12px;letter-spacing:2px;padding:4px 12px;margin-bottom:14px}\n.plans-note{margin-top:28px;font-size:13px;color:var(--muted)}\n\n/* 使用说明步骤 */\n.steps{counter-reset:step;max-width:52em}\n.step{position:relative;padding:0 0 40px 72px;border-left:1px solid var(--line);margin-left:16px}\n.step:last-child{padding-bottom:0}\n.step::before{counter-increment:step;content:counter(step,decimal-leading-zero);position:absolute;left:-17px;top:0;width:34px;height:34px;background:var(--ink);color:var(--amber);font-size:13px;font-weight:700;letter-spacing:1px;display:flex;align-items:center;justify-content:center}\n.step h3{font-size:17px;color:var(--ink);margin-bottom:8px;letter-spacing:1px}\n.step p{font-size:14.5px;color:var(--muted);max-width:40em}\n\n/* 客户端区块 */\n.clients{display:grid;grid-template-columns:repeat(2,1fr);gap:56px}\n.client h3{font-size:17px;color:var(--ink);margin-bottom:12px;letter-spacing:1px}\n.client h3::before{content:\"\";display:block;width:28px;height:3px;background:var(--amber);margin-bottom:14px}\n.client p{font-size:14.5px;color:var(--muted)}\n.client .meta{margin-top:14px;font-size:13px;color:var(--muted);border-top:1px dashed var(--line);padding-top:12px}\n.client .meta span{display:inline-block;margin-right:18px}\n\n/* FAQ 按主题分组 */\n.faq-group{margin-bottom:56px}\n.faq-group > h3{font-size:19px;color:var(--ink);letter-spacing:1px;padding-bottom:12px;margin-bottom:8px;border-bottom:2px solid var(--ink)}\n.faq-group > h3 span{color:var(--amber-deep);font-size:13px;letter-spacing:2px;margin-right:12px}\n.qa{padding:22px 0;border-bottom:1px dashed var(--line)}\n.qa:last-child{border-bottom:none}\n.qa h4{font-size:15.5px;color:var(--ink);font-weight:600;margin-bottom:8px}\n.qa h4::before{content:\"问　\";color:var(--amber-deep);font-weight:700}\n.qa p{font-size:14.5px;color:var(--muted);padding-left:2.2em}\n.qa p::before{content:\"答　\";color:var(--ink);font-weight:700;margin-left:-2.2em}\n\n/* 页脚 */\nfooter{background:var(--ink);color:#8ba3ba;padding:48px 24px;font-size:13px}\nfooter .wrap{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap}\nfooter b{color:#dbe6f0;letter-spacing:2px}\nfooter a{color:#a9bdd0}\n\n@media (max-width:900px){\n  .hero-inner{grid-template-columns:1fr;gap:44px;padding:64px 24px 72px}\n  .cards{grid-template-columns:1fr;gap:44px}\n  .plans{flex-direction:column;align-items:stretch}\n  .plan:nth-child(n){min-height:0}\n  .clients{grid-template-columns:1fr;gap:44px}\n  .topbar-inner{gap:16px}\n}\n</style><header class=\"topbar\">\n  <div class=\"topbar-inner\">\n    <span class=\"brand-mark\">小蓝<em>加速</em></span>\n    <nav aria-label=\"页面导航\">\n      <a href=\"#overview\">服务说明</a>\n      <a href=\"#plans\">订阅档位</a>\n      <a href=\"#setup\">使用说明</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</header>\n\n<main>\n\n\n<section class=\"hero\">\n  <div class=\"hero-inner\">\n    <div class=\"hero-copy\">\n      <p class=\"kicker\">订阅服务说明书 · 版本 2025</p>\n      <h1>小蓝加速<br><span>档位、额度与配置顺序</span></h1>\n      <p class=\"lede\">本页是小蓝加速的产品说明文档，按说明书体例编写：先列档位与计费口径，再列配置步骤，最后汇总常见问题。所有额度、设备数与价格以本页为准，开通前请逐项核对。</p>\n      <p class=\"lede\">三档订阅的区别仅在流量额度、同时在线设备数与线路范围，计费方式一致，均为按月或按年预付。</p>\n      <div class=\"hero-actions\">\n        <a class=\"btn btn-solid\" href=\"#plans\">查看档位对照</a>\n        <a class=\"btn btn-ghost\" href=\"#setup\">阅读配置步骤</a>\n      </div>\n    </div>\n    <aside class=\"hero-panel\" aria-label=\"服务参数速览\">\n      <h2>参数速览</h2>\n      <dl>\n        <div class=\"spec-row\"><dt>档位数量</dt><dd><b>3</b> 档</dd></div>\n        <div class=\"spec-row\"><dt>起步价格</dt><dd><b>¥15</b>/月</dd></div>\n        <div class=\"spec-row\"><dt>月流量范围</dt><dd>100GB – 1000GB</dd></div>\n        <div class=\"spec-row\"><dt>同时在线设备</dt><dd>3 – 20 台</dd></div>\n        <div class=\"spec-row\"><dt>计费方式</dt><dd>按月 / 按年预付</dd></div>\n        <div class=\"spec-row\"><dt>年付口径</dt><dd>按 10 个月计</dd></div>\n        <div class=\"spec-row\"><dt>支持渠道</dt><dd>工单系统</dd></div>\n      </dl>\n      <p class=\"panel-note\">说明：年付价格按 10 个月折算，即付 10 个月费用使用 12 个月。流量按自然月结算，当月未用完部分不结转。</p>\n    </aside>\n  </div>\n</section>\n\n\n<section class=\"block\" id=\"overview\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">01 / 服务说明</span>\n      <h2>三档订阅的共同口径</h2>\n      <p>以下内容适用于全部档位，不再在各档位说明中重复。差异项仅在「订阅档位」一节列出。</p>\n    </div>\n    <div class=\"cards\">\n      <article class=\"card\">\n        <h3>计费与周期</h3>\n        <p>订阅按自然月计算，自支付成功之日起满一个自然月为一个周期。按年支付一次性扣费，按 10 个月价格折算，使用期为 12 个月。</p>\n        <p>周期内流量用尽后，可续购同档或升级档位；升级按剩余天数折算差价。</p>\n      </article>\n      <article class=\"card\">\n        <h3>设备计数方式</h3>\n        <p>设备数以「同时在线」计，不以安装数量计。例如基础版允许 3 台设备同时在线，可在多于 3 台设备上安装客户端，轮换使用。</p>\n        <p>超出同时在线数时，最早接入的会话将被断开，不影响账户本身。</p>\n      </article>\n      <article class=\"card\">\n        <h3>流量结算</h3>\n        <p>流量按客户端实际收发字节统计，上行与下行合并计算。每月 1 日 00:00 重置额度，重置时间与订阅起始日无关。</p>\n        <p>当月剩余流量不结转至次月，也不折抵费用。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"block\" id=\"plans\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">02 / 订阅档位</span>\n      <h2>档位对照，由低到高排列</h2>\n      <p>三档按额度递进排列，右侧档位包含左侧档位的全部能力。中间档位为多数个人用户的选择。</p>\n    </div>\n    <div class=\"plans\">\n      <article class=\"plan\">\n        <p class=\"tag\">入门档</p>\n        <h3>基础版</h3>\n        <p class=\"price\">¥15<small> /月</small></p>\n        <p class=\"annual\">按年付 ¥150/年（按 10 个月计）</p>\n        <ul>\n          <li>每月 100GB 流量</li>\n          <li>3 台设备同时在线</li>\n          <li>基础流媒体访问</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <a class=\"pick\" href=\"#\">选择基础版</a>\n      </article>\n      <article class=\"plan featured\">\n        <span class=\"badge\">多数用户选择</span>\n        <p class=\"tag\">进阶档</p>\n        <h3>旗舰版</h3>\n        <p class=\"price\">¥35<small> /月</small></p>\n        <p class=\"annual\">按年付 ¥350/年（按 10 个月计）</p>\n        <ul>\n          <li>每月 300GB 流量</li>\n          <li>5 台设备同时在线</li>\n          <li>全节点流媒体访问</li>\n          <li>游戏场景线路优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n        <a class=\"pick\" href=\"#\">选择旗舰版</a>\n      </article>\n      <article class=\"plan\">\n        <p class=\"tag\">多人 / 团队档</p>\n        <h3>团队版</h3>\n        <p class=\"price\">¥85<small> /月</small></p>\n        <p class=\"annual\">按年付 ¥850/年（按 10 个月计）</p>\n        <ul>\n          <li>每月 1000GB 流量</li>\n          <li>20 台设备同时在线</li>\n          <li>专属高带宽节点</li>\n          <li>支持定制路由规则</li>\n          <li>专属客户经理对接</li>\n        </ul>\n        <a class=\"pick\" href=\"#\">选择团队版</a>\n      </article>\n    </div>\n    <p class=\"plans-note\">注：档位之间可随时升级，升级按剩余天数折算差价；暂不支持周期内降级，降级于下个计费周期生效。</p>\n  </div>\n</section>\n\n\n<section class=\"block\" id=\"setup\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">03 / 使用说明</span>\n      <h2>从开通到接入的四个步骤</h2>\n      <p>以下顺序适用于全部档位。每一步完成后再进行下一步，跳步配置是多数接入失败的原因。</p>\n    </div>\n    <ol class=\"steps\">\n      <li class=\"step\">\n        <h3>注册账户并选择档位</h3>\n        <p>使用常用邮箱注册账户，在「订阅档位」一节确定所需档位后完成支付。支付成功后，账户后台会生成订阅信息，包含订阅链接与到期时间。</p>\n      </li>\n      <li class=\"step\">\n        <h3>在设备上安装客户端</h3>\n        <p>按设备系统选择对应客户端，安装来源见下一节「客户端」。安装完成后先不要手动填写任何参数，直接进入下一步。</p>\n      </li>\n      <li class=\"step\">\n        <h3>导入订阅链接</h3>\n        <p>在账户后台复制订阅链接，粘贴到客户端的「订阅 / 导入」入口，客户端会自动拉取节点列表与配置。此后无需逐条手动填写，节点更新也由订阅自动同步。</p>\n      </li>\n      <li class=\"step\">\n        <h3>选择节点并验证连通</h3>\n        <p>在节点列表中选择一个节点接入，打开任意网页验证连通。若不通，先切换节点，再检查系统时间是否准确；两步仍不通时，按「常见问题」第四组提交工单。</p>\n      </li>\n    </ol>\n  </div>\n</section>\n\n\n<section class=\"block\" id=\"clients\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">04 / 客户端</span>\n      <h2>各系统的接入方式</h2>\n      <p>小蓝加速通过订阅链接与通用客户端配合工作。以下按系统列出接入方式；具体客户端版本与下载入口以账户后台「客户端」页提供的为准。</p>\n    </div>\n    <div class=\"clients\">\n      <article class=\"client\">\n        <h3>Windows / macOS</h3>\n        <p>桌面系统使用支持订阅导入的通用客户端。安装后在订阅管理中粘贴账户后台的订阅链接，更新订阅后即可在节点列表中选择接入。</p>\n        <p>建议开启客户端的「系统代理」模式；如需仅对特定应用生效，可改用规则模式。</p>\n        <p class=\"meta\"><span>配置方式：订阅链接导入</span><span>下载地址：见账户后台</span></p>\n      </article>\n      <article class=\"client\">\n        <h3>iOS</h3>\n        <p>iOS 设备使用支持订阅的客户端 App。由于 App Store 区域政策差异，可用应用以账户后台「客户端」页的当前说明为准，安装后同样通过订阅链接导入配置。</p>\n        <p class=\"meta\"><span>配置方式：订阅链接导入</span><span>下载地址：见账户后台</span></p>\n      </article>\n      <article class=\"client\">\n        <h3>Android</h3>\n        <p>Android 设备使用支持订阅导入的客户端。安装后粘贴订阅链接并更新，选择节点后按系统提示允许 VPN 连接请求即可。</p>\n        <p class=\"meta\"><span>配置方式：订阅链接导入</span><span>下载地址：见账户后台</span></p>\n      </article>\n      <article class=\"client\">\n        <h3>路由器与其他设备</h3>\n        <p>团队版用户如需在路由器等网关上接入，可在账户后台开启定制路由支持，由客户经理提供对应配置说明。基础版与旗舰版不含此项。</p>\n        <p class=\"meta\"><span>配置方式：团队版专属</span><span>入口：账户后台工单</span></p>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"block\" id=\"faq\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">05 / 常见问题</span>\n      <h2>按主题分组的问答</h2>\n      <p>问题按「计费」「额度与设备」「客户端配置」「故障与支持」四组排列。提交工单前请先查阅对应分组。</p>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3><span>A 组</span>计费相关</h3>\n      <article class=\"qa\">\n        <h4>年付的折算方式是什么？</h4>\n        <p>年付按 10 个月价格收取，使用 12 个月。例如基础版月付 ¥15，年付为 ¥150，而非 ¥180。三档均按此口径。</p>\n      </article>\n      <article class=\"qa\">\n        <h4>周期内可以更换档位吗？</h4>\n        <p>可以随时升级，升级按当前周期剩余天数折算差价，立即生效。暂不支持周期内降级，降级申请于下个计费周期开始时生效。</p>\n      </article>\n      <article class=\"qa\">\n        <h4>到期未续费会怎样？</h4>\n        <p>到期后订阅进入停用状态，节点列表不再更新，接入会被拒绝。账户与订阅信息保留，续费后即时恢复，无需重新配置客户端。</p>\n      </article>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3><span>B 组</span>额度与设备</h3>\n      <article class=\"qa\">\n        <h4>流量用完后可以直接加量吗？</h4>\n        <p>可以。流量用尽后可续购同档位重置当月额度，或升级到更高档位。次月 1 日额度也会自动重置，二者互不影响。</p>\n      </article>\n      <article class=\"qa\">\n        <h4>设备数限制是按安装数量算吗？</h4>\n        <p>不是。设备数按同时在线计。例如旗舰版允许 5 台同时在线，可在任意数量的设备上安装客户端，超出时最早接入的会话会被断开。</p>\n      </article>\n      <article class=\"qa\">\n        <h4>当月剩余流量能转到下个月吗？</h4>\n        <p>不能。流量按自然月结算，每月 1 日 00:00 重置，剩余部分不结转、不折抵费用。</p>\n      </article>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3><span>C 组</span>客户端配置</h3>\n      <article class=\"qa\">\n        <h4>需要手动填写节点参数吗？</h4>\n        <p>不需要。全部配置通过订阅链接导入，节点列表与参数由订阅自动同步。手动填写仅在订阅不可用时作为临时手段，参数需通过工单索取。</p>\n      </article>\n      <article class=\"qa\">\n        <h4>订阅链接在哪里查看？</h4>\n        <p>登录账户后台，在「我的订阅」页面复制订阅链接。链接等同于账户凭证，请勿转发给他人；如怀疑泄露，可在后台重置链接，重置后旧链接立即失效。</p>\n      </article>\n      <article class=\"qa\">\n        <h4>更换设备后需要重新购买吗？</h4>\n        <p>不需要。在新设备上安装客户端并导入同一订阅链接即可，受同时在线设备数限制，不受更换次数限制。</p>\n      </article>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3><span>D 组</span>故障与支持</h3>\n      <article class=\"qa\">\n        <h4>连上之后打不开网页，先检查什么？</h4>\n        <p>按顺序检查三项：一，切换其他节点；二，校准设备系统时间，时间偏差会导致握手失败；三，在客户端中更新订阅。三项均无效时再提交工单。</p>\n      </article>\n      <article class=\"qa\">\n        <h4>工单需要提供哪些信息？</h4>\n        <p>请提供：账户邮箱、所用档位、设备系统与版本、客户端名称、出现问题的时间点、已尝试的排查步骤。信息齐全可显著缩短处理时间。旗舰版与团队版工单优先处理。</p>\n      </article>\n      <article class=\"qa\">\n        <h4>支持渠道只有工单吗？</h4>\n        <p>个人档位（基础版、旗舰版）的支持渠道为工单系统。团队版另配专属客户经理，可通过约定渠道直接对接。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div>\n      <b>小蓝加速</b>\n      <p>订阅档位与使用说明 · 本页内容以账户后台实时信息为准</p>\n    </div>\n    <div>\n      <a href=\"#plans\">订阅档位</a> · <a href=\"#setup\">使用说明</a> · <a href=\"#faq\">常见问题</a>\n    </div>\n  </div>\n</footer>",
